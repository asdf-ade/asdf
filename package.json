{
	"name": "asdf",
	"private": true,
	"version": "0.2.0",
	"description": "Agentic development environment for running coding agents like Claude Code and Codex in parallel, each in its own git worktree.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/asdf-ade/asdf.git"
	},
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "tsc && electron-vite build",
		"preview": "electron-vite preview",
		"package": "pnpm build && electron-builder",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
		"test": "vitest run",
		"knip": "knip",
		"prepare": "husky",
		"check:locales": "node scripts/check-locales.mjs",
		"bootstrap": "node scripts/bootstrap.mjs"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@xterm/addon-fit": "0.10.0",
		"@xterm/xterm": "5.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electron-updater": "^6.8.9",
		"i18next": "^26.4.1",
		"lucide-react": "^1.39.0",
		"node-pty": "^1.1.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-i18next": "^17.0.13",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"ts-pattern": "^5.9.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/node": "^26.4.1",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"electron": "^44.1.1",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"husky": "^9.1.7",
		"knip": "^6.34.0",
		"lint-staged": "^17.4.1",
		"shadcn": "^4.19.1",
		"typescript": "~5.8.3",
		"vite": "^7.0.4",
		"vitest": "^5.0.0"
	},
	"packageManager": "pnpm@10.14.0",
	"engines": {
		"node": ">=22"
	}
}
